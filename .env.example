# Copy to .env. Hostnames below (db, redis) are Docker Compose service names.
# Running the API on the host instead? Use localhost in both URLs.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/salonbook
REDIS_URL=redis://redis:6379/0
SECRET_KEY=change-me
CORS_ORIGINS=http://localhost:3000
PORT=8000
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxx
RESEND_API_KEY=re_xxxxxxxx

# Used by the postgres container only (must match DATABASE_URL above)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=salonbook
