# Copy to .env. These URLs are for running the API/tests on the host.
# Docker Compose maps Postgres to host port 5433 and overrides DATABASE_URL/REDIS_URL
# for the api container (db:5432, redis:6379), so no change is needed for Docker.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/salonbook
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=change-me
# local | test | production (default if unset). Anything but local/test refuses to start with a weak SECRET_KEY.
ENVIRONMENT=local
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=http://localhost:3000
PORT=8000
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxx
RESEND_API_KEY=re_xxxxxxxx

# Used by the postgres container only (must match DATABASE_URL above)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=salonbook
